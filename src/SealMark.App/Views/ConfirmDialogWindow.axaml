<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SealMark.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200" 
        WindowStartupLocation="CenterOwner" CanMaximize="False" CanMinimize="False" CanResize="False"
        x:Class="SealMark.App.Views.ConfirmDialogWindow"
        x:DataType="vm:ConfirmDialogWindowViewModel"
        Title="{Binding Title}" Width="300" Height="100">
  <Design.DataContext>
      <vm:ConfirmDialogWindowViewModel></vm:ConfirmDialogWindowViewModel>
  </Design.DataContext>
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{Binding ConfirmBtnText}" 
                    Classes="Primary" 
                    Theme="{DynamicResource SolidButton}" 
                    LetterSpacing="5" 
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="{Binding CancelBtnText}" 
                    Classes="Tertiary" 
                    Theme="{DynamicResource OutlineButton}" 
                    LetterSpacing="5"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
